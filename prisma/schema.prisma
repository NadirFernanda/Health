generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String        @id @default(cuid())
  email                  String        @unique
  passwordHash           String
  role                   Role
  criadoEm               DateTime      @default(now())
  isActive               Boolean       @default(true)
  lastLoginAt            DateTime?
  phone                  String?
  updatedEm              DateTime      @updatedAt
  verifiedAt             DateTime?
  clinica                Clinica?
  consultorio            Consultorio?
  credenciaisVerificadas Credencial[]  @relation("CredencialVerificadaPor")
  notificacoes           Notificacao[]
  profissional           Profissional?
  mensagens              Mensagem[]
  supportTickets         SupportTicket[]
  supportTicketReplies   SupportTicketReply[]
  pushSubscriptions      PushSubscription[]
  auditLogs              AuditLog[]
  disputasAbertas        Disputa[]            @relation("DisputasAbertas")
  disputasMensagens      DisputaMensagem[]
  adminRole              AdminRole?
  adminEmail             String?
  adminCargo             String?
  adminPhone             String?
  adminPermissions       AdminPermission[]
  adminSecurity          AdminSecurity?
  adminNotifications     AdminNotification?
}

model Profissional {
  id                    String              @id @default(cuid())
  userId                String              @unique
  nome                  String
  tipo                  TipoProfissional    @default(MEDICO)
  especialidade         String
  numeroOrdem           String?
  numeroSinome          String?             @unique
  provincia             String              @default("Luanda")
  foto                  String?
  bio                   String?
  rating                Float               @default(0)
  totalAvaliacoes       Int                 @default(0)
  totalPlantoes         Int                 @default(0)
  verified              Boolean             @default(false)
  estadoVerificacao     String              @default("PENDENTE")
  verificadoEm          DateTime?
  rejeicaoMotivo        String?
  saldoCarteira         Int                 @default(0)
  saldoCarteiraCentavos BigInt              @default(0)
  disponivelAgora       Boolean             @default(false)
  anosExperiencia       Int?
  metrics               Json?               @default("{}")
  bairro                String?
  cidade                String?
  numeroOma             String?
  subEspecialidade      String?
  avaliacoesRecebidas   Avaliacao[]         @relation("AlvoMedicoAvaliacao")
  avaliacoesFeitas      Avaliacao[]         @relation("AutorAvaliacao")
  candidaturas          Candidatura[]
  credenciais           Credencial[]
  documentos            Documento[]
  pagamentosRecebidos   Pagamento[]         @relation("PagamentoBeneficiario")
  plantoesPublicados    Plantao[]           @relation("PlantaoPublicadoPorMedico")
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservas              ReservaSala[]
  transacoes            TransacaoCarteira[]
  saques                PedidoSaque[]

  @@index([tipo])
  @@index([especialidade])
  @@index([verified])
  @@index([estadoVerificacao])
  @@index([disponivelAgora])
}

model Clinica {
  id                  String              @id @default(cuid())
  userId              String              @unique
  nome                String
  morada              String?
  cidade              String?
  provincia           String              @default("Luanda")
  logo                String?
  rating              Float               @default(0)
  totalAvaliacoes     Int                 @default(0)
  verified            Boolean             @default(false)
  estadoVerificacao   String              @default("PENDENTE")
  rejeicaoMotivo      String?
  alvara              String?
  bairro              String?
  contacto            String?
  descricao           String?
  latitude            Decimal?            @db.Decimal(10, 7)
  longitude           Decimal?            @db.Decimal(10, 7)
  updatedEm           DateTime            @updatedAt
  website             String?
  zonaLuanda          String?
  criadoEm            DateTime            @default(now())
  avaliacoesRecebidas Avaliacao[]         @relation("AlvoClinicaAvaliacao")
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plantoes            Plantao[]
  salas               Sala[]
  documentos          ClinicaDocumento[]

  @@index([zonaLuanda])
  @@index([verified])
  @@index([estadoVerificacao])
}

model ClinicaDocumento {
  id           String          @id @default(cuid())
  clinicaId    String
  tipo         String
  ficheiro     String?
  estado       EstadoDocumento @default(NAO_ENVIADO)
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt
  clinica      Clinica         @relation(fields: [clinicaId], references: [id], onDelete: Cascade)

  @@unique([clinicaId, tipo])
  @@index([clinicaId])
  @@index([estado])
}

model Consultorio {
  id              String   @id @default(cuid())
  userId          String   @unique
  nome            String
  morada          String?
  bairro          String?
  zonaLuanda      String?
  contacto        String?
  cidade          String?
  provincia       String   @default("Luanda")
  descricao       String?
  rating          Float    @default(0)
  totalAvaliacoes Int      @default(0)
  verified        Boolean  @default(false)
  criadoEm        DateTime @default(now())
  updatedEm       DateTime @default(now()) @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  salas           Sala[]

  @@index([zonaLuanda])
  @@index([verified])
}

model Plantao {
  id                       String           @id @default(cuid())
  clinicaId                String?
  especialidade            String
  dataInicio               DateTime
  dataFim                  DateTime
  valorKwanzas             Int
  vagas                    Int
  vagasPreenchidas         Int              @default(0)
  estado                   EstadoPlantao    @default(ABERTO)
  descricao                String?
  maca                     Boolean          @default(false)
  estetoscopio             Boolean          @default(false)
  tensiometro              Boolean          @default(false)
  termometro               Boolean          @default(false)
  computador               Boolean          @default(false)
  materiaisBasicos         Boolean          @default(true)
  nebulizador              Boolean          @default(false)
  oximetro                 Boolean          @default(false)
  glucometro               Boolean          @default(false)
  desfibrilador            Boolean          @default(false)
  criadoEm                 DateTime         @default(now())
  atualizadoEm             DateTime         @updatedAt
  valorCentavos            BigInt?
  salaId                   String?
  tipoProfissional         TipoProfissional @default(MEDICO)
  profissionalPublicadorId String?
  publicadoPorMedico       Boolean          @default(false)
  avaliacoes               Avaliacao[]
  candidaturas             Candidatura[]
  pagamentos               Pagamento[]
  clinica                  Clinica?         @relation(fields: [clinicaId], references: [id])
  profissionalPublicador   Profissional?    @relation("PlantaoPublicadoPorMedico", fields: [profissionalPublicadorId], references: [id])
  sala                     Sala?            @relation(fields: [salaId], references: [id])

  @@index([clinicaId])
  @@index([especialidade])
  @@index([tipoProfissional])
  @@index([dataInicio])
  @@index([estado])
}

model Candidatura {
  id             String            @id @default(cuid())
  plantaoId      String
  profissionalId String
  estado         EstadoCandidatura @default(PENDENTE)
  criadoEm           DateTime          @default(now())
  mensagem           String?
  respondidoEm       DateTime?
  contratoGeradoEm   DateTime?
  contratoAssinadoEm DateTime?
  plantao            Plantao           @relation(fields: [plantaoId], references: [id])
  profissional   Profissional      @relation(fields: [profissionalId], references: [id])
  pagamentos     Pagamento[]
  mensagens      Mensagem[]
  disputas       Disputa[]

  @@unique([plantaoId, profissionalId])
  @@index([plantaoId])
  @@index([profissionalId])
  @@index([estado])
}

model Mensagem {
  id            String      @id @default(cuid())
  candidaturaId String
  autorUserId   String
  corpo         String
  lida          Boolean     @default(false)
  criadoEm     DateTime    @default(now())
  candidatura   Candidatura @relation(fields: [candidaturaId], references: [id], onDelete: Cascade)
  autor         User        @relation(fields: [autorUserId], references: [id])

  @@index([candidaturaId])
  @@index([autorUserId])
}

model Sala {
  id                   String                @id @default(cuid())
  clinicaId            String?
  nome                 String
  tipo                 TipoSala
  precoPorHora         Int
  zona                 String
  descricao            String?
  fotos                String[]              @default([])
  disponivel           Boolean               @default(true)
  avaliacaoMedia       Float                 @default(0)
  totalAvaliacoes      Int                   @default(0)
  maca                 Boolean               @default(false)
  estetoscopio         Boolean               @default(false)
  tensiometro          Boolean               @default(false)
  termometro           Boolean               @default(false)
  computador           Boolean               @default(false)
  materiaisBasicos     Boolean               @default(true)
  nebulizador          Boolean               @default(false)
  oximetro             Boolean               @default(false)
  glucometro           Boolean               @default(false)
  desfibrilador        Boolean               @default(false)
  criadoEm             DateTime              @default(now())
  ativo                Boolean               @default(true)
  atualizadoEm         DateTime              @updatedAt
  numero               String?
  politicaCancel       String?
  precoPorHoraCentavos BigInt?
  consultorioId        String?
  avaliacoes           Avaliacao[]           @relation("AlvoSalaAvaliacao")
  disponibilidades     DisponibilidadeSala[]
  plantoes             Plantao[]
  reservas             ReservaSala[]
  clinica              Clinica?              @relation(fields: [clinicaId], references: [id], onDelete: Restrict)
  consultorio          Consultorio?          @relation(fields: [consultorioId], references: [id])

  @@index([clinicaId])
  @@index([tipo])
  @@index([ativo])
  @@index([consultorioId])
}

model ReservaSala {
  id                    String        @id @default(cuid())
  salaId                String
  profissionalId        String
  data                  DateTime
  horaInicio            String
  duracaoHoras          Int
  valorTotal            Int
  estado                EstadoReserva @default(CONFIRMADA)
  codigoQr              String        @default(cuid())
  criadoEm              DateTime      @default(now())
  atualizadoEm          DateTime      @updatedAt
  canceladoEm           DateTime?
  comissaoAoa           Int?
  dataFim               DateTime?
  motivoCancelamento    String?
  pagoEm                DateTime?
  valorClinicaAoa       Int?
  valorTotalCentavos    BigInt?
  terminadoEm           DateTime?
  vistoriaOk            Boolean?
  vistoriaNotas         String?
  vistoriaEquipamentos  String?
  vistoriaEm            DateTime?
  contratoGeradoEm      DateTime?
  contratoAssinadoEm    DateTime?
  pagamentos            Pagamento[]
  profissional          Profissional  @relation(fields: [profissionalId], references: [id])
  sala                  Sala          @relation(fields: [salaId], references: [id])

  @@index([salaId])
  @@index([profissionalId])
  @@index([estado])
}

model Avaliacao {
  id              String         @id @default(cuid())
  autorId         String?
  alvoMedicoId    String?
  alvoClinicaId   String?
  salaId          String?
  plantaoId       String?
  estrelas        Int
  comentario      String?
  criadoEm        DateTime       @default(now())
  avaliadoRole    String?
  avaliadoUserId  String?
  avaliadorUserId String?
  tipo            AvaliacaoTipo?
  alvoClinica     Clinica?       @relation("AlvoClinicaAvaliacao", fields: [alvoClinicaId], references: [id])
  alvoMedico      Profissional?  @relation("AlvoMedicoAvaliacao", fields: [alvoMedicoId], references: [id])
  autor           Profissional?  @relation("AutorAvaliacao", fields: [autorId], references: [id])
  plantao         Plantao?       @relation(fields: [plantaoId], references: [id])
  sala            Sala?          @relation("AlvoSalaAvaliacao", fields: [salaId], references: [id])

  @@index([autorId])
  @@index([alvoClinicaId])
  @@index([alvoMedicoId])
  @@index([plantaoId])
}

model Credencial {
  id              String           @id @default(cuid())
  profissionalId  String
  tipo            CredencialTipo
  ficheiroUrl     String?
  ficheiroNome    String?
  ficheiroTamanho Int?
  estado          CredencialEstado @default(PENDENTE)
  express         Boolean          @default(false)
  comentario      String?
  verificadoPorId String?
  verificadoEm    DateTime?
  criadoEm        DateTime         @default(now())
  atualizadoEm    DateTime         @updatedAt
  profissional    Profissional     @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  verificadoPor   User?            @relation("CredencialVerificadaPor", fields: [verificadoPorId], references: [id])

  @@index([profissionalId])
  @@index([estado])
}

model DisponibilidadeSala {
  id         String   @id @default(cuid())
  salaId     String
  diaSemana  Int
  horaInicio String
  horaFim    String
  disponivel Boolean  @default(true)
  criadoEm   DateTime @default(now())
  sala       Sala     @relation(fields: [salaId], references: [id], onDelete: Cascade)

  @@index([salaId, diaSemana])
}

model Pagamento {
  id                         String          @id @default(cuid())
  tipo                       PagamentoTipo
  plantaoId                  String?
  candidaturaId              String?
  reservaSalaId              String?
  valorBrutoAoa              Int
  comissaoAoa                Int
  valorLiquidoAoa            Int
  metodo                     PagamentoMetodo
  estado                     PagamentoEstado @default(PENDENTE)
  referenciaExt              String?
  webhookPayload             Json?
  pagoEm                     DateTime?
  liberadoEm                 DateTime?
  retryAttempts              Int              @default(0)
  nextRetryAt                DateTime?
  falhaMotivo                String?
  criadoEm                   DateTime        @default(now())
  atualizadoEm               DateTime        @updatedAt
  beneficiarioProfissionalId String?
  beneficiario               Profissional?   @relation("PagamentoBeneficiario", fields: [beneficiarioProfissionalId], references: [id])
  candidatura                Candidatura?    @relation(fields: [candidaturaId], references: [id])
  plantao                    Plantao?        @relation(fields: [plantaoId], references: [id])
  reservaSala                ReservaSala?    @relation(fields: [reservaSalaId], references: [id])

  @@index([candidaturaId])
  @@index([reservaSalaId])
  @@index([beneficiarioProfissionalId])
  @@index([estado])
  @@index([referenciaExt])
}

model Documento {
  id             String          @id @default(cuid())
  profissionalId String
  tipo           String
  ficheiro       String?
  estado         EstadoDocumento @default(NAO_ENVIADO)
  criadoEm       DateTime        @default(now())
  atualizadoEm   DateTime        @updatedAt
  profissional   Profissional    @relation(fields: [profissionalId], references: [id])
}

model TransacaoCarteira {
  id             String          @id @default(cuid())
  profissionalId String
  tipo           TipoTransacao
  descricao      String
  estado         EstadoTransacao @default(PROCESSADO)
  criadoEm       DateTime        @default(now())
  valorCentavos  BigInt
  referencia     String?
  profissional   Profissional    @relation(fields: [profissionalId], references: [id])

  @@index([profissionalId])
  @@index([tipo])
  @@index([criadoEm])
}

model Notificacao {
  id       String   @id @default(cuid())
  userId   String
  tipo     String
  titulo   String
  corpo    String
  href     String?
  lida     Boolean  @default(false)
  criadoEm DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([lida])
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String?
  action    String
  detalhes  Json
  usuarioId String?
  criadoEm  DateTime @default(now())
  usuario   User?    @relation(fields: [usuarioId], references: [id])

  @@index([entity, entityId])
  @@index([usuarioId])
}

model SupportTicket {
  id               String                  @id @default(cuid())
  numero           Int                     @default(autoincrement()) @unique
  userId           String
  categoria        String
  assunto          String
  mensagem         String
  estado           SupportTicketEstado     @default(ABERTO)
  prioridade       SupportTicketPrioridade @default(NORMAL)
  userProvidedId   String?
  contactoEmail    String?
  contactoTelefone String?
  criadoEm         DateTime                @default(now())
  atualizadoEm     DateTime                @updatedAt
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  respostas        SupportTicketReply[]

  @@index([userId])
  @@index([estado])
  @@index([prioridade])
  @@index([criadoEm])
}

model SupportTicketReply {
  id              String    @id @default(cuid())
  ticketId        String
  autorUserId     String
  corpo           String
  isAdminReply    Boolean   @default(false)
  criadoEm        DateTime  @default(now())
  ticket          SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  autor           User      @relation(fields: [autorUserId], references: [id])

  @@index([ticketId])
  @@index([autorUserId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  criadoEm DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  ADMIN
  MEDICO
  CLINICA
  PROFISSIONAL
  PROPRIETARIO_SALA
}

enum TipoProfissional {
  MEDICO
  ENFERMEIRO
  TECNICO_SAUDE
  OUTRO
}

enum EstadoPlantao {
  AGUARDANDO_PAGAMENTO
  ABERTO
  FECHADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum EstadoCandidatura {
  PENDENTE
  CONTRATO_PENDENTE
  AGUARDANDO_PAGAMENTO
  ACEITE
  CONCLUIDO
  RECUSADO
  CANCELADA
}

enum EstadoDocumento {
  NAO_ENVIADO
  PENDENTE
  APROVADO
  REJEITADO
}

enum TipoTransacao {
  CREDITO
  DEBITO
}

enum EstadoTransacao {
  PENDENTE
  PROCESSADO
  PROCESSANDO
  CONFIRMADO
  FALHOU
  REEMBOLSADO
}

enum TipoSala {
  CONSULTORIO
  OBSERVACAO
  PROCEDIMENTOS
  SALA_CURATIVO
  OUTRO
}

enum EstadoReserva {
  CONFIRMADA
  CANCELADA
  CONCLUIDA
  PENDENTE_PAGAMENTO
  CANCELADA_PROFISSIONAL
  CANCELADA_CLINICA
  AGUARDANDO_VISTORIA
  DISPUTA_SALA
  CONTRATO_PENDENTE
}

enum CredencialTipo {
  BI_PASSAPORTE
  CEDULA_OMA
  REGISTO_SINOME
  DIPLOMA_LICENCIATURA
  CERTIFICADO_ESPECIALIZACAO
  OUTRO
}

enum CredencialEstado {
  PENDENTE
  APROVADO
  REJEITADO
  EXPRESS_PENDENTE
}

enum PagamentoTipo {
  TURNO
  SALA
}

enum PagamentoMetodo {
  MULTICAIXA_EXPRESS
  TRANSFERENCIA_BANCARIA
  TPA
}

enum PagamentoEstado {
  PENDENTE
  PROCESSANDO
  CONFIRMADO
  FALHOU
  REEMBOLSADO
}

enum AvaliacaoTipo {
  TURNO
  SALA
}

enum SupportTicketEstado {
  ABERTO
  EM_ANDAMENTO
  FECHADO
}

enum SupportTicketPrioridade {
  NORMAL
  ALTA
  URGENTE
}

model Disputa {
  id             String        @id @default(cuid())
  candidaturaId  String
  iniciadoPorId  String
  tipo           DisputaTipo
  descricao      String
  estado         DisputaEstado @default(ABERTA)
  resolucaoNota  String?
  ajusteValorKz  Int?
  ajusteParaId   String?
  criadoEm       DateTime      @default(now())
  resolvidoEm    DateTime?
  candidatura    Candidatura   @relation(fields: [candidaturaId], references: [id])
  iniciadoPor    User          @relation("DisputasAbertas", fields: [iniciadoPorId], references: [id])
  mensagens      DisputaMensagem[]

  @@index([candidaturaId])
  @@index([estado])
  @@index([criadoEm])
}

model DisputaMensagem {
  id        String   @id @default(cuid())
  disputaId String
  autorId   String
  corpo     String
  criadoEm DateTime @default(now())
  disputa   Disputa  @relation(fields: [disputaId], references: [id], onDelete: Cascade)
  autor     User     @relation(fields: [autorId], references: [id])

  @@index([disputaId])
}

enum EstadoSaque {
  PENDENTE
  APROVADO
  REJEITADO
  CANCELADO
}

model PedidoSaque {
  id             String       @id @default(cuid())
  profissionalId String
  valorAoa       Int
  valorCentavos  BigInt
  dadosBancarios Json
  estado         EstadoSaque  @default(PENDENTE)
  motivoRejeicao String?
  adminId        String?
  criadoEm       DateTime     @default(now())
  processadoEm   DateTime?
  profissional   Profissional @relation(fields: [profissionalId], references: [id])

  @@index([profissionalId])
  @@index([estado])
  @@index([criadoEm])
}

enum DisputaTipo {
  NAO_COMPARECEU
  NAO_PAGOU
  QUALIDADE
  CANCELAMENTO
  OUTRO
}

enum DisputaEstado {
  ABERTA
  EM_ANALISE
  RESOLVIDA
  ENCERRADA
}

enum AdminRole {
  FINANCEIRO
  GESTOR
  SUPORTE
  ANALISTA
}

enum AdminAccessLevel {
  NONE
  READ
  WRITE
  FULL
}

enum AdminNotificationChannel {
  EMAIL
  SYSTEM
  BOTH
}

model AdminPermission {
  id     String           @id @default(cuid())
  userId String
  module String
  access AdminAccessLevel @default(NONE)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@index([userId])
}

model AdminSecurity {
  id                    String  @id @default(cuid())
  userId                String  @unique
  twoFactorRequired     Boolean @default(false)
  ipRestriction         Boolean @default(false)
  allowedIps            Json    @default("[]")
  sessionTimeoutEnabled Boolean @default(false)
  sessionTimeoutMinutes Int     @default(30)
  forcePasswordChange   Boolean @default(false)
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminNotification {
  id                         String                   @id @default(cuid())
  userId                     String                   @unique
  notifyNewUser              Boolean                  @default(true)
  notifyNewDispute           Boolean                  @default(true)
  notifyKycPending           Boolean                  @default(true)
  notifyPayoutRequest        Boolean                  @default(true)
  notifyHighValueTransaction Boolean                  @default(false)
  notifySystemError          Boolean                  @default(true)
  notifyDailyReport          Boolean                  @default(false)
  channel                    AdminNotificationChannel @default(SYSTEM)
  user                       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
